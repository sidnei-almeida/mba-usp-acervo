# ---------------------------------------------------------------------------
# Vercel Blob — armazenamento dos PDFs e capas. É o primeiro driver escolhido
# quando presente. Crie a store em Storage > Blob (público) e rode
# `vercel env pull` para trazer as variáveis.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=
# Domínio público da store, para as capas irem direto do CDN ao navegador:
# NEXT_PUBLIC_BLOB_BASE_URL=https://xxxxxxxx.public.blob.vercel-storage.com

# ---------------------------------------------------------------------------
# Armazenamento S3-compatível — Backblaze B2, Cloudflare R2, MinIO.
# O bucket pode ser PRIVADO: leitura e envio usam URL assinada, e nem o B2 nem
# o R2 cobram a mais por isso.
# ---------------------------------------------------------------------------
# Backblaze B2 (keyID e applicationKey da chave de aplicação):
# B2_KEY_ID=
# B2_APPLICATION_KEY=
# B2_BUCKET=silo-acervo
# B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Cloudflare R2:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=

# Genéricos, se preferir um nome só: S3_ENDPOINT, S3_ACCESS_KEY_ID,
# S3_SECRET_ACCESS_KEY, S3_BUCKET, S3_REGION.
# Domínio público servindo o bucket, quando houver:
# S3_PUBLIC_BASE_URL=https://arquivos.seudominio.com

# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=acervo-mba-usp-esalq
# Opcional: endpoint S3 customizado (por padrão usa o do R2_ACCOUNT_ID)
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# Opcional: domínio público servindo o bucket (habilita URLs diretas)
# R2_PUBLIC_BASE_URL=https://arquivos.seudominio.com

# ---------------------------------------------------------------------------
# Neon (Postgres) — usuários e catálogo. Sem esta variável, os metadados ficam
# em JSON junto dos arquivos (bom para desenvolvimento, não para produção).
# ---------------------------------------------------------------------------
# Aceita também POSTGRES_URL, DATABASE_URL_UNPOOLED ou POSTGRES_URL_NON_POOLING.
DATABASE_URL=postgresql://usuario:senha@ep-xxx.neon.tech/neondb?sslmode=require

# Segredo usado para assinar o cookie de sessão.
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Opcional: chave da API do Google Books. Sem ela, a busca de capas usa apenas
# a Open Library (o acesso anônimo do Google esbarra em cota).
GOOGLE_BOOKS_API_KEY=

# Otimização de PDF (usa ghostscript e qpdf quando existirem na máquina).
# PDF_OPTIMIZE=false desliga; PDF_TARGET_DPI ajusta a resolução das imagens.
# PDF_OPTIMIZE=true
# PDF_TARGET_DPI=170
# PDF_OPTIMIZE_MAX_MB=120
# GHOSTSCRIPT_PATH=/usr/bin/gs
# QPDF_PATH=/usr/bin/qpdf

# Popular o acervo com material de demonstração quando estiver vazio.
SEED_DEMO=true

# URL pública do site (usada em metadados).
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Fila e cota de tráfego. O acervo entrega poucos arquivos por vez para caber
# no plano gratuito do Backblaze B2 — 1 GB de download e 2500 transações
# classe B por dia, que zeram à meia-noite UTC. Passando disso o B2 responde
# com erro em vez do arquivo, então o app para antes dele. Todos os valores
# abaixo são opcionais; os padrões já ficam abaixo do limite gratuito.
# ---------------------------------------------------------------------------
# Transferências simultâneas em todo o site (padrão 3):
# TRAFEGO_SIMULTANEOS=3
# Orçamento de saída por dia, em MB (padrão 820, abaixo do 1 GB gratuito):
# TRAFEGO_ORCAMENTO_MB=820
# Transações classe B por dia (padrão 2100, abaixo das 2500 gratuitas):
# TRAFEGO_TRANSACOES=2100
# Downloads por pessoa por dia (padrão 12):
# TRAFEGO_POR_PESSOA=12
# Quanto tempo uma vaga fica reservada, em segundos (padrão 150):
# TRAFEGO_VAGA_SEGUNDOS=150
# O mesmo para quem está lendo no navegador (padrão 600):
# TRAFEGO_LEITURA_SEGUNDOS=600
# Quanto tempo uma senha de fila sobrevive sem a página perguntar (padrão 90):
# TRAFEGO_FILA_SEGUNDOS=90
# Pausa geral depois que o próprio B2 recusa uma leitura, em minutos (padrão 5):
# TRAFEGO_PAUSA_MINUTOS=5
# Fração do arquivo cobrada da cota quando a pessoa lê em vez de baixar, já que
# o leitor busca só as páginas abertas (padrão 0.5):
# TRAFEGO_FRACAO_LEITURA=0.5
