# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dados locais do driver de armazenamento
/.data/

# worker copiado do pdfjs-dist
/public/pdf.worker.min.mjs

# acervos locais de PDF: fonte dos envios, nunca versionados
/DS/
/GESTAO/
/LivrosDev/
/Livros-UNOPAR-main/
/Programming-Books-main/
/Soft_Skills/
/TI_e_Desenvolvimento/
/Cursos de Programas/
